{
  "providers": {
    "orfree": {
      "apiKey": "${ORFREE_API_KEY}",
      "apiBase": "http://localhost:20128/v1"
    },
    "mistral": {
      "apiKey": "${MISTRAL_API_KEY}"
    }
  },
  "modelPresets": {
    "primary": {
      "label": "kilonek",
      "provider": "orfree",
      "model": "kilonek",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1
    },
    "kilonek": {
      "label": "kilonek",
      "provider": "orfree",
      "model": "kilonek",
      "maxTokens": 8192,
      "contextWindowTokens": 200000,
      "temperature": 0.1
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "primary",
      "fallbackModels": [
        "kilonek"
      ],
      "maxTokens": 8192,
      "maxToolIterations": 40,
      "maxConcurrentSubagents": 2
    }
  },
  "channels": {
    "sendProgress": true,
    "sendToolHints": true,
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "groupPolicy": "mention",
      "allowFrom": [
        "*"
      ]
    }
  },
  "tools": {
    "mcpServers": {
      "notion": {
        "command": "npx",
        "args": [
          "-y",
          "@notionhq/notion-mcp-server"
        ],
        "env": {
          "NOTION_TOKEN": "${NOTION_TOKEN}"
        },
        "toolTimeout": 60
      },
      "tinyfish": {
        "command": "python",
        "args": [
          "C:\\Users\\tantt\\.nanobot\\workspace\\skills\\tinyfish-mcp\\scripts\\tinyfish_mcp.py"
        ],
        "env": {
          "TINYFISH_API_KEY": "${TINYFISH_API_KEY}"
        },
        "toolTimeout": 150
      }
    }
  }
}
