{
  "name": "Nanobot AI Agent Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhook": "POST /nanobot-task"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8766/v1/chat/completions",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "model": "orfree",
          "messages": [
            {
              "role": "user",
              "content": "={{$json.task}}"
            }
          ],
          "max_tokens": 4096,
          "temperature": 0.1,
          "stream": false
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "nanobot-api-call",
      "name": "Call Nanobot API",
      "type": "n8n-nodes-base.http-request",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.statusCode}}",
              "operation": "equal",
              "value2": "200"
            }
          ]
        }
      },
      "id": "check-response",
      "name": "Check Response",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "text": "={{$json.body.choices[0].message.content}}",
        "chat_id": "={{$env.TELEGRAM_NOTIFY_CHAT_ID}}",
        "parse_mode": "Markdown"
      },
      "id": "send-telegram",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "text": "Nanobot API error: {{$json.statusCode}} - {{$json.body.error?.message || $json.body}}"
      },
      "id": "send-error",
      "name": "Send Error",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 2,
      "position": [850, 400]
    },
    {
      "parameters": {
        "text": "Task completed. Result: {{$json.body.choices[0].message.content}}"
      },
      "id": "return-result",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 600]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Call Nanobot API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Nanobot API": {
      "main": [
        [
          {
            "node": "Check Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Telegram": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1"
}
